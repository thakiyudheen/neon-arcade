# When hosting both on the same server (single host), leave this empty to use same-origin.
# If hosting frontend and socket on different hosts, set to the socket server URL (e.g. https://your-socket.onrender.com)
NEXT_PUBLIC_SOCKET_URL=

# Origin(s) allowed to connect to the Socket.IO server. Comma-separated.
# For same-origin custom server, this can be left as http://localhost:3000 or your domain.
CLIENT_ORIGIN=http://localhost:3000

# Port the server listens on (used by custom server / hosts).
PORT=3000
SOCKET_PORT=4000

# STUN server used for WebRTC voice chat (optional, defaults to Google STUN).
NEXT_PUBLIC_STUN_URL=stun:stun.l.google.com:19302

# Optional TURN relay for voice chat across restrictive networks.
# STUN alone is not guaranteed to work on every network.
NEXT_PUBLIC_TURN_URL=
NEXT_PUBLIC_TURN_USERNAME=
NEXT_PUBLIC_TURN_CREDENTIAL=
